<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="./vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory suffix="Test.php">./tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory suffix="Test.php">./tests/Feature</directory>
        </testsuite>
    </testsuites>
    <coverage processUncoveredFiles="true">
        <include>
            <directory suffix=".php">./app</directory>
        </include>
    </coverage>
    <php>
        <!-- 全量套件会重复引导 Laravel 与大量路由；显式预留测试进程内存，避免默认 256MB 令长进程中途终止。 -->
        <ini name="memory_limit" value="2048M"/>
        <server name="APP_ENV" value="testing" force="true"/>
        <server name="BCRYPT_ROUNDS" value="4"/>
        <server name="CACHE_DRIVER" value="array"/>
        <!-- 功能测试依赖 MySQL 的 DDL、索引和锁语义；数据库名称使用精确白名单，禁止继承正式库。 -->
        <server name="DATABASE_URL" value="" force="true"/>
        <server name="DB_CONNECTION" value="mysql" force="true"/>
        <server name="DB_HOST" value="127.0.0.1" force="true"/>
        <server name="DB_PORT" value="3307" force="true"/>
        <server name="DB_SOCKET" value="" force="true"/>
        <server name="DB_DATABASE" value="co_crmv5_test" force="true"/>
        <server name="MAIL_MAILER" value="array"/>
        <server name="QUEUE_CONNECTION" value="sync"/>
        <server name="SESSION_DRIVER" value="array"/>
        <server name="TELESCOPE_ENABLED" value="false"/>
        <!-- 本轮只验证本地迁移与状态机，不允许测试进程建立 MT4 连接或分发用户同步。 -->
        <server name="MT4_ENABLED" value="false" force="true"/>
        <server name="MT4_USER_SYNC_ENABLED" value="false" force="true"/>
    </php>
</phpunit>
