{
	"cleanupPeriodDays": 720,
	"env": {
		"ANTHROPIC_AUTH_TOKEN": "这里保留千刀现有的 token，不要用 sk-key",
		"ANTHROPIC_BASE_URL": "https://api.zzzcoding.org",
		"CLAUDE_CODE_MAX_CONTEXT_TOKENS": "300000",
		"CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "75",
		"CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
		"CLAUDE_CODE_ATTRIBUTION_HEADER": "0",
		"DISABLE_INSTALLATION_CHECKS": "1",
		"ENABLE_TOOL_SEARCH": "1",
		"CLAUDE_CODE_MAX_RETRIES": "5",
		"CLAUDE_CODE_ENABLE_TELEMETRY": "0",
		"CLAUDE_CODE_ENHANCED_TELEMETRY_BETA": "0",
		"CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1",
		"CLAUDE_CODE_BYOC_ENABLE_DATADOG": "0",
		"CLAUDE_CODE_PROPAGATE_TRACEPARENT": "0",
		"DISABLE_GROWTHBOOK": "1",
		"ANTHROPIC_MODEL": "claude-opus-5",
		"ANTHROPIC_DEFAULT_MODEL": "claude-opus-5",
		"ANTHROPIC_DEFAULT_OPUS_MODEL": "claude-opus-5",
		"ANTHROPIC_DEFAULT_SONNET_MODEL": "claude-opus-5",
		"ANTHROPIC_DEFAULT_HAIKU_MODEL": "claude-opus-5",
		"ANTHROPIC_DEFAULT_FABLE_MODEL": "claude-opus-5",
		"ANTHROPIC_SMALL_FAST_MODEL": "claude-opus-5",
		"CLAUDE_CODE_AUTO_MODE_MODEL": "claude-opus-5",
		"CLAUDE_CODE_BG_CLASSIFIER_MODEL": "claude-opus-5",
		"CLAUDE_CODE_SUBAGENT_MODEL": "claude-opus-5",
		"CLAUDE_CONTEXT_COLLAPSE_MODEL": "claude-opus-5"
	},
	"permissions": {
		"allow": [
			"Bash"
		],
		"defaultMode": "acceptEdits"
	},
	"worktree": {
		"baseRef": "head"
	},
	"viewMode": "verbose",
	"spinnerTipsEnabled": false,
	"spinnerVerbs": {
		"mode": "replace",
		"verbs": [
			"Processing",
			"Working",
			"Thinking"
		]
	},
	"effortLevel": "high",
	"modelSettings": {
		"claude-opus-5": {
			"effortLevel": "xhigh"
		}
	},
	"askUserQuestionTimeout": "5m",
	"tui": "fullscreen",
	"prefersReducedMotion": true,
	"showThinkingSummaries": false,
	"skipWorkflowUsageWarning": true,
	"theme": "auto",
	"editorMode": "normal",
	"preferredNotifChannel": "iterm2",
	"showTurnDuration": false,
	"showMessageTimestamps": false,
	"model": "claude-opus-5",
	"fallbackModel": [
		"claude-opus-5"
	],
	"availableModels": [
		"claude-opus-5"
	],
	"enforceAvailableModels": true,
	"skipDangerousModePermissionPrompt": true
}
